# Data import and quality control

The dataset contained one row per patient. PFS and OS were expressed in days. Event indicators were coded as 1 for an observed event and 0 for a censored observation.

No missing value was imputed.

```{r}
#| label: import-data
#| echo: false

df <- read_excel(
  "stats_QT_phD_240826.xlsx",
  na = c("", "NA")
)

names(df) <- tolower(names(df))
```

```{r}
#| label: qc-data
#| echo: false

stopifnot(
  all(df$pfs_event %in% c(0, 1)),
  all(df$os_event %in% c(0, 1)),
  all(df$pfs_days >= 0),
  all(df$os_days >= 0),
  !anyDuplicated(df$id)
)

qc <- df |>
  summarise(
    Patients = n(),
    `PFS events` = sum(pfs_event),
    `PFS censored` = sum(pfs_event == 0),
    `OS events` = sum(os_event),
    `OS censored` = sum(os_event == 0)
  )

qc |> gt()
```

Expected values are 24 patients, 9 PFS events and 13 OS events.

# 1. Distribution of nuclear and cytoplasmic HES-1 H-scores

> **Question from Quentin:**\
> “For nuclear and cytoplasmic H-score, could you provide a dotplot representation of their distribution?”

## Statistical analysis

Nuclear and cytoplasmic HES-1 H-scores were described using individual patient values. Median and interquartile range (IQR) were reported.

```{r}
#| label: prepare-hscore
#| echo: false

hscore_long <- df |>
  select(id, hscore_nuc, hscore_cyto) |>
  pivot_longer(
    cols = c(hscore_nuc, hscore_cyto),
    names_to = "Localization",
    values_to = "Hscore"
  ) |>
  mutate(
    Localization = recode(
      Localization,
      hscore_nuc = "Nuclear",
      hscore_cyto = "Cytoplasmic"
    )
  )
```

## Descriptive results

```{r}
#| label: hscore-summary
#| echo: false

hscore_summary <- hscore_long |>
  group_by(Localization) |>
  summarise(
    N = sum(!is.na(Hscore)),
    Median = median(Hscore, na.rm = TRUE),
    Q1 = quantile(Hscore, 0.25, na.rm = TRUE),
    Q3 = quantile(Hscore, 0.75, na.rm = TRUE),
    .groups = "drop"
  ) |>
  mutate(
    `Median [IQR]` = sprintf(
      "%.1f [%.1f–%.1f]",
      Median, Q1, Q3
    )
  ) |>
  select(Localization, N, `Median [IQR]`)

hscore_summary |> gt()
```

## Dotplot

```{r}
#| label: fig-hscore-dotplot
#| echo: false
#| fig-width: 7
#| fig-height: 5
#| fig-cap: "Distribution of baseline nuclear and cytoplasmic HES-1 H-scores."

ggplot(
  hscore_long,
  aes(x = Localization, y = Hscore)
) +
  geom_jitter(
    width = 0.08,
    size = 2.5,
    alpha = 0.8,
    na.rm = TRUE
  ) +
  stat_summary(
    fun = median,
    geom = "crossbar",
    width = 0.3,
    linewidth = 0.7,
    na.rm = TRUE
  ) +
  labs(
    x = NULL,
    y = "H-score"
  ) +
  theme_classic(base_size = 13)
```

# 2. HES-1 H-score as a continuous variable and survival

> **Question from Quentin:**\
> “Could you evaluate PFS and OS according to H-score, considering H-score as a continuous variable?”

## Statistical analysis

Nuclear and cytoplasmic HES-1 H-scores were analyzed separately using univariable Cox proportional hazards models.

For easier interpretation, H-scores were divided by 100. Hazard ratios therefore represent the change in hazard associated with a 100-point increase in H-score.

```{r}
#| label: prepare-hscore-continuous
#| echo: false

df <- df |>
  mutate(
    hscore_nuc_100 = hscore_nuc / 100,
    hscore_cyto_100 = hscore_cyto / 100
  )
```

```{r}
#| label: cox-hscore
#| echo: true

cox_nuc_pfs <- coxph(
  Surv(pfs_days, pfs_event) ~ hscore_nuc_100,
  data = df
)

cox_nuc_os <- coxph(
  Surv(os_days, os_event) ~ hscore_nuc_100,
  data = df
)

cox_cyto_pfs <- coxph(
  Surv(pfs_days, pfs_event) ~ hscore_cyto_100,
  data = df
)

cox_cyto_os <- coxph(
  Surv(os_days, os_event) ~ hscore_cyto_100,
  data = df
)
```

## Results

```{r}
#| label: table-hscore-cox
#| echo: false

hscore_results <- bind_rows(
  
  tidy(cox_nuc_pfs, exponentiate = TRUE, conf.int = TRUE) |>
    mutate(
      Outcome = "PFS",
      Predictor = "Nuclear H-score",
      Scale = "+100 points",
      N = cox_nuc_pfs$n,
      Events = cox_nuc_pfs$nevent
    ),
  
  tidy(cox_nuc_os, exponentiate = TRUE, conf.int = TRUE) |>
    mutate(
      Outcome = "OS",
      Predictor = "Nuclear H-score",
      Scale = "+100 points",
      N = cox_nuc_os$n,
      Events = cox_nuc_os$nevent
    ),
  
  tidy(cox_cyto_pfs, exponentiate = TRUE, conf.int = TRUE) |>
    mutate(
      Outcome = "PFS",
      Predictor = "Cytoplasmic H-score",
      Scale = "+100 points",
      N = cox_cyto_pfs$n,
      Events = cox_cyto_pfs$nevent
    ),
  
  tidy(cox_cyto_os, exponentiate = TRUE, conf.int = TRUE) |>
    mutate(
      Outcome = "OS",
      Predictor = "Cytoplasmic H-score",
      Scale = "+100 points",
      N = cox_cyto_os$n,
      Events = cox_cyto_os$nevent
    )
) |>
  transmute(
    Outcome,
    Predictor,
    Scale,
    N,
    Events,
    HR = estimate,
    CI_low = conf.low,
    CI_high = conf.high,
    p_value = p.value
  ) |>
  mutate(
    `HR [95% CI]` = sprintf(
      "%.2f [%.2f–%.2f]",
      HR, CI_low, CI_high
    ),
    `p-value` = ifelse(
      p_value < 0.001,
      "<0.001",
      sprintf("%.3f", p_value)
    )
  ) |>
  select(
    Outcome,
    Predictor,
    Scale,
    N,
    Events,
    `HR [95% CI]`,
    `p-value`
  )

hscore_results |> gt()
```

A HR greater than 1 indicates a higher hazard associated with increasing H-score, whereas a HR below 1 indicates a lower hazard.

# 3. Nuclear HES-1 H-score categories and survival

> **Question from Quentin:**\
> “For nuclear H-score, patients with an H-score \<100 were classified as low and patients with an H-score \>200 as high.”

## Statistical analysis

Only nuclear H-score was categorized.

- Low nuclear H-score: \<100
- High nuclear H-score: \>200

Patients with values between 100 and 200 were excluded from this categorical comparison.

PFS and OS were estimated using Kaplan-Meier survival curves and compared using the log-rank test. Cox regression was used to estimate the hazard ratio for High versus Low H-score.

```{r}
#| label: prepare-hscore-category
#| echo: false

df_nuc <- df |>
  mutate(
    hscore_group = case_when(
      hscore_nuc < 100 ~ "Low",
      hscore_nuc > 200 ~ "High",
      TRUE ~ NA_character_
    ),
    hscore_group = factor(
      hscore_group,
      levels = c("Low", "High")
    )
  ) |>
  filter(!is.na(hscore_group))
```

## Group composition

```{r}
#| label: hscore-group-count
#| echo: false

df_nuc |>
  count(hscore_group) |>
  rename(
    Group = hscore_group,
    N = n
  ) |>
  gt()
```

## Progression-free survival

```{r}
#| label: km-hscore-pfs
#| echo: false
#| fig-width: 7
#| fig-height: 5

km_hscore_pfs <- survfit(
  Surv(pfs_days, pfs_event) ~ hscore_group,
  data = df_nuc
)

plot(
  km_hscore_pfs,
  xlab = "Time from inclusion (days)",
  ylab = "Progression-free survival probability",
  lty = 1:2,
  lwd = 2,
  mark.time = TRUE
)

legend(
  "bottomleft",
  legend = c("H-score <100", "H-score >200"),
  lty = 1:2,
  lwd = 2,
  bty = "n"
)

#| echo: false

summary(km_hscore_pfs, times = c(0, 180, 360, 540, 720, 900), extend = TRUE) |>
  with(
    tibble(
      Group = sub("hscore_group=", "", strata),
      Time = time,
      `Number at risk` = n.risk
    )
  ) |>
  pivot_wider(
    names_from = Time,
    values_from = `Number at risk`
  ) |>
  gt() |>
  tab_header(title = "Number at risk")
```

```{r}
#| label: logrank-hscore-pfs
#| echo: false

logrank_hscore_pfs <- survdiff(
  Surv(pfs_days, pfs_event) ~ hscore_group,
  data = df_nuc
)

p_hscore_pfs <- pchisq(
  logrank_hscore_pfs$chisq,
  df = 1,
  lower.tail = FALSE
)

tibble(
  Test = "Log-rank",
  `p-value` = ifelse(
    p_hscore_pfs < 0.001,
    "<0.001",
    sprintf("%.3f", p_hscore_pfs)
  )
) |> gt()
```

