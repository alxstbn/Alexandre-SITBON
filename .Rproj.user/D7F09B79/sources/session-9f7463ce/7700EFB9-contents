# Publication figures

The following figures reproduce the survival analyses presented above using a standardized graphical format intended for publication. No statistical analysis was recalculated or modified.

```{r}
#| label: publication-km-function
#| include: false

plot_km_publication <- function(
  fit,
  ylab,
  legend_labels = NULL,
  title = NULL,
  x_breaks = seq(0, 900, 180)
) {

  n_groups <- if (is.null(fit$strata)) {
    1
  } else {
    length(fit$strata)
  }

  pub_colors <- if (n_groups == 1) {
    "#2C5F8A"
  } else {
    c("#2C5F8A", "#B44A3C")
  }

  par(
    mar = c(5, 5, 2.5, 1),
    las = 1
  )

  plot(
    fit,
    xlab = "Time from inclusion (days)",
    ylab = ylab,
    main = title,
    xlim = c(0, max(x_breaks)),
    ylim = c(0, 1),
    xaxt = "n",
    yaxt = "n",
    col = pub_colors,
    lty = 1,
    lwd = 2.8,
    mark.time = TRUE,
    cex.lab = 1.15,
    bty = "l",
    conf.int = FALSE
  )

  axis(
    side = 1,
    at = x_breaks,
    labels = x_breaks
  )

  axis(
    side = 2,
    at = seq(0, 1, 0.2),
    labels = paste0(seq(0, 100, 20), "%"),
    las = 1
  )

  if (!is.null(legend_labels)) {
    legend(
      "topright",
      legend = legend_labels,
      col = pub_colors,
      lty = 1,
      lwd = 2.8,
      bty = "n",
      cex = 0.95
    )
  }
}
