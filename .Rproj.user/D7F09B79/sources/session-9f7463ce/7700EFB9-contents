```

```{r}
#| label: cox-ctdna
#| echo: true

cox_ctdna_pfs <- coxph(
  Surv(pfs_days, pfs_event) ~ ctdna_t1_100,
  data = df
)

cox_ctdna_os <- coxph(
  Surv(os_days, os_event) ~ ctdna_t1_100,
  data = df
)
```

